<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pins the backend root logger to INFO so that, absent the extension, isDebugEnabled()
  delegates to the backend and returns false. This isolates the meta-@ExtendWith on
  @EffectiveLogLevel as the only thing that can flip isDebugEnabled() to true.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger -- %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
