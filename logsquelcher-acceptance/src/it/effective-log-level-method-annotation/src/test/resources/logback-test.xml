<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pins the backend root logger to INFO so that, absent @EffectiveLogLevel, isDebugEnabled()
  would be false. This isolates the annotation as the only thing that enables the guarded
  debug logging, giving the CapturedLogs presence assertion teeth.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger -- %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
